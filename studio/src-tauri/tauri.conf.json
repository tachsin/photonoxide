{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "photonoxide",
  "mainBinaryName": "photonoxide",
  "identifier": "gr.tachsin.photonoxide",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1430",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "publisher": "tachsin",
    "copyright": "MIT OR Apache-2.0",
    "license": "MIT OR Apache-2.0",
    "homepage": "https://tachsin.gr/projects/photonoxide",
    "category": "Education",
    "shortDescription": "Photonics simulation, with a live studio",
    "longDescription": "photonoxide simulates integrated photonics: mode solvers, FDFD and FDTD, circuits, thermal and electro-optic devices, and inverse design. Its studio runs jobs live, reproduces published results, and replays their records.",
    "licenseFile": "installer/license.txt",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "uninstallerHeaderImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp",
        "installerHooks": "installer/hooks.nsh"
      }
    },
    "macOS": {
      "dmg": {
        "background": "installer/dmg-background.png",
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 }
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ4NDBFMUFGMzk5Nzg0N0UKUldSK2hKYzVyK0ZBU0xuRWtDY2RWVlJ1YzJnaGpMeS91SlJkQnQzVEpPMjBhbHFNZlRYbzhhbUcK",
      "endpoints": [
        "https://github.com/tachsin/photonoxide/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
