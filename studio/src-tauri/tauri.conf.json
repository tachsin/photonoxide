{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "photonoxide",
  "mainBinaryName": "photonoxide",
  "version": "0.2.0",
  "identifier": "gr.tachsin.photonoxide",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1430",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
