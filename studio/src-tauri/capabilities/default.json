{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "the studio window: core; dialogs for job files, run folders and the workspace; opening links and folders; the updater and the restart after it",
  "windows": ["studio"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-ask",
    "dialog:allow-message",
    "opener:allow-open-url",
    "opener:allow-reveal-item-in-dir",
    "updater:default",
    "process:allow-restart"
  ]
}
