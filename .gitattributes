# what the examples print, compared byte for byte by CI and locally: LF everywhere
examples/output/*.txt text eol=lf
python/examples/output/*.txt text eol=lf
# shell scripts and git hooks: bash on Windows reads them too, and a carriage return breaks it
*.sh text eol=lf
.github/hooks/* text eol=lf
# the Docker image and the Slurm cluster in Docker: Linux reads these files, whatever system checked them out
docker/** text eol=lf
