#!/usr/bin/env bash
# After a merge (a pull too): the full suite in the background, its output in
# target/full-suite.log; not a second one while one runs. Enabled by
# `git config core.hooksPath .github/hooks` (.github/full-suite.sh).
# Not in an agent's worktree (a linked worktree under .claude/worktrees/, see agent-worktree.sh):
# the suite is an hour of cargo and would build a target/ of its own there (1 to 30 GB), so the
# hook does nothing; run the suite by hand from the main checkout when you want it.
# In the main checkout it also removes the build folders of agent worktrees that are gone
# (.github/scripts/prune-agent-targets.sh).
# shellcheck source=agent-worktree.sh
source "$(dirname "$0")/agent-worktree.sh"
if agent_worktree; then
  echo "post-merge: the full suite is skipped in an agent worktree (it would build a target/ of its own here); run it from the main checkout"
  exit 0
fi
root=$(git rev-parse --show-toplevel)
mkdir -p "$root/target"
# the build folders of agent worktrees that are gone (target/agents/<name>, see agent-worktree.sh),
# removed in the background, the list in target/prune-agent-targets.log
if [ -d "$(agent_targets_root)" ]; then
  nohup bash "$(dirname "$0")/../scripts/prune-agent-targets.sh" > "$root/target/prune-agent-targets.log" 2>&1 &
fi
pid=$(cat "$root/target/full-suite.pid" 2>/dev/null)
if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
  echo "the full suite is still running ($root/target/full-suite.log)"
  exit 0
fi
nohup bash "$root/.github/full-suite.sh" > "$root/target/full-suite.log" 2>&1 &
echo $! > "$root/target/full-suite.pid"
echo "the full suite started: $root/target/full-suite.log"
