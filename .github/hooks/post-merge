#!/usr/bin/env bash
# After a merge (a pull too): the full suite in the background, its output in
# target/full-suite.log; not a second one while one runs. Enabled by
# `git config core.hooksPath .github/hooks` (.github/full-suite.sh).
root=$(git rev-parse --show-toplevel)
mkdir -p "$root/target"
pid=$(cat "$root/target/full-suite.pid" 2>/dev/null)
if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
  echo "the full suite is still running ($root/target/full-suite.log)"
  exit 0
fi
nohup bash "$root/.github/full-suite.sh" > "$root/target/full-suite.log" 2>&1 &
echo $! > "$root/target/full-suite.pid"
echo "the full suite started: $root/target/full-suite.log"
